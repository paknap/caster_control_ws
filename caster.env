# Laptop environment for communicating with caster and viewing its model.
source /opt/ros/jazzy/setup.bash
if [ -f "$HOME/RTV/caster_control_ws/install/local_setup.bash" ]; then
  source "$HOME/RTV/caster_control_ws/install/local_setup.bash"
fi

# Match the Fast DDS publishers on caster.
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
export ROS_DOMAIN_ID=0
export ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET
export ROS_STATIC_PEERS=caster
unset CYCLONEDDS_URI ROS_LOCALHOST_ONLY

ros2 daemon stop
printf 'Caster environment: ROS=%s, RMW=%s, domain=%s, peer=%s\n' \
  "$ROS_DISTRO" "$RMW_IMPLEMENTATION" "$ROS_DOMAIN_ID" "$ROS_STATIC_PEERS"
