<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lslidar">
  <xacro:macro name="lslidar" params="min_angle:=${-pi} max_angle:=${pi}">
    <link name="laser_link">
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
      <visual>
        <origin xyz="0 0 -0.041" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://robot_description/description/meshes/laser.dae" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
    </link>
