<?xml version='1.0' encoding='UTF-8'?>
<package format="2">
  <name>odrive_ros</name>
  <version>0.8.1</version>
  <description>ODrive motor controller driver for ROS</description>
  <license>Modified BSD</license>

  <maintainer email="josh.marshall@tecevo.com">Josh Marshall, Tecevo</maintainer>
  <url type="website">https://github.com/neomanic/odrive_ros</url>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>
  
  <!-- Commented out, will be installed locally -->
  <!-- <exec_depend>ODrive</exec_depend> -->

  <export>
    <!-- Other tools can request additional information be placed here -->
    <build_type>ament_python</build_type>
  </export>
<exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend><exec_depend>tf2_ros</exec_depend><exec_depend>python3-numpy</exec_depend><exec_depend>python3-serial</exec_depend><buildtool_depend>python3-setuptools</buildtool_depend></package>
